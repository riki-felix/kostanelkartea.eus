# Copy to .env.deploy and fill with values from MyKinsta > Sites > LIVE > Info > SFTP/SSH.
# .env.deploy is gitignored.
#
# LIVE is production. Local is DevKinsta; there is no PRE or DEV environment on Kinsta.
# This deploy syncs code only (theme + plugins). Database, uploads and wp-config on
# the server are never modified by the script.

KINSTA_SSH_HOST=12.34.56.78
KINSTA_SSH_PORT=12345
KINSTA_SSH_USER=your-site-user
KINSTA_SSH_PASSWORD=your-ssh-password

# Absolute path: MyKinsta > Info > Environment details > Path
KINSTA_REMOTE_PATH=/www/your-site/public

# Optional: SSH key instead of password (recommended for CI).
# KINSTA_SSH_KEY=$HOME/.ssh/kinsta_deploy

# Optional overrides:
# DRY_RUN=true          # preview without writing (recommended first run)
# BUILD_THEME=true
# PURGE_CACHE=true
